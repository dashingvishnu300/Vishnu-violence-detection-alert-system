{
  "dataset": {
    "name": "sfd",
    "data_root": "data",
    "sequence_length": 16,
    "sampling_strategy": "uniform",
    "image_size": 224,
    "train_split": 0.7,
    "val_split": 0.15,
    "test_split": 0.15
  },
  "model": {
    "name": "vgg16",
    "backbone": "resnet18",
    "num_classes": 2,
    "pretrained": true,
    "freeze_backbone": true,
    "lstm_hidden_size": 256,
    "lstm_num_layers": 1,
    "lstm_dropout": 0.3,
    "classifier_dropout": 0.5
  },
  "training": {
    "epochs": 5,
    "batch_size": 4,
    "num_workers": 4,
    "pin_memory": true,
    "optimizer": "adamw",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "scheduler": "cosine",
    "scheduler_patience": 5,
    "scheduler_step_size": 10,
    "scheduler_gamma": 0.1,
    "early_stopping_patience": 7,
    "use_amp": true,
    "use_class_weights": false,
    "gradient_clip": 1.0
  },
  "augmentation": {
    "horizontal_flip": true,
    "random_rotation": 10,
    "color_jitter": true,
    "brightness": 0.2,
    "contrast": 0.2,
    "random_erasing": false
  },
  "evaluation": {
    "thresholds": [
      0.3,
      0.4,
      0.5,
      0.6,
      0.7,
      0.8,
      0.9
    ],
    "save_false_positives": true,
    "save_false_negatives": true,
    "generate_gradcam": true
  },
  "experiment": {
    "name": "sfd_vgg16_16frames",
    "seed": 42,
    "save_dir": "experiments",
    "log_interval": 10
  },
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  }
}